{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "benchmark",
  "framework",
  "judgments",
  "limits"
 ],
 "properties": {
  "benchmark": {
   "type": "string"
  },
