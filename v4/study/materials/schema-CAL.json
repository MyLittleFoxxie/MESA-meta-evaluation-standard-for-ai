{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "benchmark",
  "framework",
  "judgments",
  "limits"
 ],
 "properties": {
  "benchmark": {
   "type": "string"
  },
  "framework": {
   "type": "string",
   "enum": [
    "CAL"
   ]
  },
  "limits": {
   "type": "string"
  },
  "judgments": {
   "type": "array",
   "minItems": 28,
   "maxItems": 28,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "item_id",
     "answer",
     "basis",
     "reason",
     "evidence",
     "missing",
     "checks"
    ],
    "properties": {
     "item_id": {
      "type": "string",
      "enum": [
       "CAL-IO-1",
       "CAL-IO-2",
       "CAL-IO-3",
       "CAL-IO-4",
       "CAL-IC-1",
       "CAL-IC-2",
       "CAL-IC-3",
       "CAL-IC-4",
       "CAL-IC-5",
       "CAL-IF-1",
       "CAL-IF-2",
       "CAL-IF-3",
       "CAL-IF-4",
       "CAL-OO-1",
       "CAL-OO-2",
       "CAL-OO-3",
       "CAL-OO-4",
       "CAL-OO-5",
       "CAL-OC-1",
       "CAL-OC-2",
       "CAL-OC-3",
       "CAL-OC-4",
       "CAL-OC-5",
       "CAL-OC-6",
       "CAL-OF-1",
       "CAL-OF-2",
       "CAL-OF-3",
       "CAL-OF-4"
      ]
     },
     "answer": {
      "type": "string",
      "enum": [
       "1",
       "2",
       "3",
       "4",
       "5",
       "unknown"
      ]
     },
     "basis": {
      "type": "string",
      "enum": [
       "evidence_found",
       "absence_of_information",
       "defect_found",
       "not_applicable"
      ]
     },
     "reason": {
      "type": "string"
     },
     "missing": {
      "type": "string"
     },
     "checks": {
      "type": "string"
     },
     "evidence": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "source",
        "locator",
        "quote"
       ],
       "properties": {
        "source": {
         "type": "string"
        },
        "locator": {
         "type": "string"
        },
        "quote": {
         "type": "string"
        }
       }
      }
     }
    }
   }
  }
 }
}
