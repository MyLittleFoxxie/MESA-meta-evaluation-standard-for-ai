{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "benchmark",
  "framework",
  "description",
  "judgments",
  "limits"
 ],
 "properties": {
  "benchmark": {
   "type": "string"
  },
  "framework": {
   "type": "string",
   "enum": [
    "RUBRIC"
   ]
  },
  "limits": {
   "type": "string"
  },
  "description": {
   "type": "array",
   "minItems": 8,
   "maxItems": 8,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "facet",
     "value",
     "reason",
     "evidence"
    ],
    "properties": {
     "facet": {
      "type": "string",
      "enum": [
       "Purpose",
       "Judgeability",
       "Reference",
       "Containedness",
       "Objectivity",
       "Autonomy",
       "Progression",
       "Variation"
      ]
     },
     "value": {
      "type": "string"
     },
     "reason": {
      "type": "string"
     },
     "evidence": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "source",
        "locator",
        "quote"
       ],
       "properties": {
        "source": {
         "type": "string"
        },
        "locator": {
         "type": "string"
        },
        "quote": {
         "type": "string"
        }
       }
      }
     }
    }
   }
  },
  "judgments": {
   "type": "array",
   "minItems": 29,
   "maxItems": 29,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "item_id",
     "answer",
     "basis",
     "reason",
     "evidence",
     "missing",
     "checks"
    ],
    "properties": {
     "item_id": {
      "type": "string",
      "enum": [
       "B01",
       "B02",
       "B03",
       "B04",
       "B05",
       "B06",
       "B07",
       "B08",
       "B09",
       "B10",
       "B11",
       "B12",
       "B13",
       "B14",
       "B15",
       "B16",
       "B17",
       "B18",
       "B19",
       "B20",
       "B21",
       "B22",
       "B23",
       "B24",
       "B25",
       "B26",
       "B27",
       "B28",
       "B29"
      ]
     },
     "answer": {
      "type": "string",
      "enum": [
       "stated",
       "shown",
       "checked",
       "contradicted",
       "insufficient_evidence",
       "not_applicable"
      ]
     },
     "basis": {
      "type": "string",
      "enum": [
       "evidence_found",
       "absence_of_information",
       "defect_found",
       "not_applicable"
      ]
     },
     "reason": {
      "type": "string"
     },
     "missing": {
      "type": "string"
     },
     "checks": {
      "type": "string"
     },
     "evidence": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "source",
        "locator",
        "quote"
       ],
       "properties": {
        "source": {
         "type": "string"
        },
        "locator": {
         "type": "string"
        },
        "quote": {
         "type": "string"
        }
       }
      }
     }
    }
   }
  }
 }
}
