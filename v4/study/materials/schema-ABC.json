{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "benchmark",
  "framework",
  "judgments",
  "limits"
 ],
 "properties": {
  "benchmark": {
   "type": "string"
  },
  "framework": {
   "type": "string",
   "enum": [
    "ABC"
   ]
  },
  "limits": {
   "type": "string"
  },
  "judgments": {
   "type": "array",
   "minItems": 44,
   "maxItems": 44,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "item_id",
     "answer",
     "basis",
     "reason",
     "evidence",
     "missing",
     "checks"
    ],
    "properties": {
     "item_id": {
      "type": "string",
      "enum": [
       "ABC-T.1",
       "ABC-T.2",
       "ABC-T.3",
       "ABC-T.4",
       "ABC-T.5",
       "ABC-T.6",
       "ABC-T.7",
       "ABC-T.8",
       "ABC-T.9",
       "ABC-T.10",
       "ABC-O.a.1",
       "ABC-O.a.2",
       "ABC-O.b.1",
       "ABC-O.b.2",
       "ABC-O.b.3",
       "ABC-O.c.1",
       "ABC-O.c.2",
       "ABC-O.d.1",
       "ABC-O.d.2",
       "ABC-O.e.1",
       "ABC-O.e.2",
       "ABC-O.e.3",
       "ABC-O.f.1",
       "ABC-O.f.2",
       "ABC-O.f.3",
       "ABC-O.g.1",
       "ABC-O.g.2",
       "ABC-O.g.3",
       "ABC-O.h.1",
       "ABC-O.h.2",
       "ABC-O.i.1",
       "ABC-R.1",
       "ABC-R.2",
       "ABC-R.3",
       "ABC-R.4",
       "ABC-R.5",
       "ABC-R.6",
       "ABC-R.7",
       "ABC-R.8",
       "ABC-R.9",
       "ABC-R.10",
       "ABC-R.11",
       "ABC-R.12",
       "ABC-R.13"
      ]
     },
     "answer": {
      "type": "string",
      "enum": [
       "1",
       "0"
      ]
     },
     "basis": {
      "type": "string",
      "enum": [
       "evidence_found",
       "absence_of_information",
       "defect_found",
       "not_applicable"
      ]
     },
     "reason": {
      "type": "string"
     },
     "missing": {
      "type": "string"
     },
     "checks": {
      "type": "string"
     },
     "evidence": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "source",
        "locator",
        "quote"
       ],
       "properties": {
        "source": {
         "type": "string"
        },
        "locator": {
         "type": "string"
        },
        "quote": {
         "type": "string"
        }
       }
      }
     }
    }
   }
  }
 }
}
