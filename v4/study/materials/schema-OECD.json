{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "benchmark",
  "framework",
  "judgments",
  "limits"
 ],
 "properties": {
  "benchmark": {
   "type": "string"
  },
  "framework": {
   "type": "string",
   "enum": [
    "OECD"
   ]
  },
  "limits": {
   "type": "string"
  },
  "judgments": {
   "type": "array",
   "minItems": 18,
   "maxItems": 18,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "item_id",
     "answer",
     "basis",
     "reason",
     "evidence",
     "missing",
     "checks"
    ],
    "properties": {
     "item_id": {
      "type": "string",
      "enum": [
       "OECD-Capability",
       "OECD-Coverage",
       "OECD-Purpose",
       "OECD-Realism",
       "OECD-Reference",
       "OECD-Specificity",
       "OECD-Adjustability",
       "OECD-Containedness",
       "OECD-Judgeability",
       "OECD-Reliability",
       "OECD-Reproducibility",
       "OECD-Variation",
       "OECD-Ambition",
       "OECD-Antecedents",
       "OECD-Autonomy",
       "OECD-Objectivity",
       "OECD-Partiality",
       "OECD-Progression"
      ]
     },
     "answer": {
      "type": "string"
     },
     "basis": {
      "type": "string",
      "enum": [
       "evidence_found",
       "absence_of_information",
       "defect_found",
       "not_applicable"
      ]
     },
     "reason": {
      "type": "string"
     },
     "missing": {
      "type": "string"
     },
     "checks": {
      "type": "string"
     },
     "evidence": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "source",
        "locator",
        "quote"
       ],
       "properties": {
        "source": {
         "type": "string"
        },
        "locator": {
         "type": "string"
        },
        "quote": {
         "type": "string"
        }
       }
      }
     }
    }
   }
  }
 }
}
