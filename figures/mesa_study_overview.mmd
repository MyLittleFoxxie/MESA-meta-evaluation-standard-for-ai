---
config:
  layout: elk
---
flowchart LR
    classDef input fill:#f2f2f2,stroke:#555555,color:#000000
    classDef step fill:#ffffff,stroke:#333333,color:#000000
    classDef rq fill:#d9d9d9,stroke:#333333,color:#000000
    classDef check fill:#ffffff,stroke:#777777,stroke-dasharray:4 3,color:#000000

    F("Seven<br/>frameworks<br/>280 questions"):::input
    C["30 shared<br/>concerns"]:::step
    B("Four<br/>benchmarks"):::input
    R["MESA rubric<br/>39 criteria"]:::step
    K["Checks:<br/>planted defects<br/>known defects<br/>confirmation scripts"]:::check
    S1["Study 1<br/>six frameworks<br/>one model"]:::step
    S2["Study 2<br/>MESA rubric<br/>two model<br/>families<br/>two runs each"]:::step
    Q1["RQ1<br/>RQ2"]:::rq
    Q2["RQ2<br/>RQ3"]:::rq

    F --> S1
    F --> C --> R --> S2
    F ~~~ B
    B --> S1
    B --> S2
    K -.- S2
    S1 --> Q1
    S2 --> Q2
