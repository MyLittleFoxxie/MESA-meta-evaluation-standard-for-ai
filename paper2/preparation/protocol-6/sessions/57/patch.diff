+class SkewNormalDistribution(SingleContinuousDistribution):
+    _argnames = ('xi', 'omega', 'alpha')
+
+    @staticmethod
+    def check(xi, omega, alpha):
+        _value_check(xi.is_real, "Location parameter must be real")
+        _value_check(omega.is_positive, "Scale parameter must be positive")
+        _value_check(alpha.is_real, "Shape parameter must be real")
+
+    def pdf(self, x):
+        z = (x - self.xi)/self.omega
+        return exp(-z**2/2)*(1 + erf(self.alpha*z/sqrt(2)))/(sqrt(2*pi)*self.omega)
+
+    def _cdf(self, x):
+        z = (x - self.xi)/self.omega
+        return S.Half + erf(z/sqrt(2))/2 - 2*owens_t(z, self.alpha)
+
+
+def SkewNormal(name, xi, omega, alpha):
+    r"""
+    Create a continuous random variable with a skew-normal distribution.
+
+    The density of the skew-normal distribution is
+
+    .. math::
+        f(x) = \frac{2}{\omega}\phi\left(\frac{x-\xi}{\omega}\right)
+               \Phi\left(\alpha\frac{x-\xi}{\omega}\right),
+
+    where :math:`\phi` and :math:`\Phi` are the standard normal density
+    and cumulative distribution functions. When ``alpha`` is zero, this
+    reduces to the normal distribution with mean ``xi`` and standard
+    deviation ``omega``.
+
+    Parameters
+    ==========
+
+    xi : Real number, the location
+    omega : Positive real number, the scale
+    alpha : Real number, the shape
+
+    Examples
+    ========
+
+    >>> from sympy.stats import SkewNormal, density, cdf
+    >>> X = SkewNormal('X', 0, 1, 2)
+    >>> density(X)(0)
+    sqrt(2)/(2*sqrt(pi))
+    >>> cdf(X)(0)
+    -atan(2)/pi + 1/2
+
+    References
+    ==========
+
+    .. [1] https://en.wikipedia.org/wiki/Skew_normal_distribution
+    """
+    return rv(name, SkewNormalDistribution, (xi, omega, alpha))
+
+
