+class GaussianErfRule(IRule):
+    """Integrate a Gaussian times an error function using Owen's T."""
+
+    __slots__ = ()
+
+    def eval(self) -> Expr:
+        a, b, x = self.a, self.b, self.variable
+        return -2*sqrt(S.Pi)/sqrt(a)*owens_t(sqrt(2)*sqrt(a)*x, b/sqrt(a))
+
