+class owens_t(DefinedFunction):
+    r"""
+    Owen's T function.
+
+    Explanation
+    ===========
+
+    For real $h$ and $a$, this function is defined by
+
+    .. math::
+        T(h, a) = \frac{1}{2\pi} \int_0^a
+            \frac{\exp(-h^2(1 + t^2)/2)}{1 + t^2}\,\mathrm{d}t.
+
+    It is even in $h$ and odd in $a$. The integral also defines its
+    analytic continuation to complex arguments, with branch points at
+    $a = \pm i$.
+
+    Examples
+    ========
+
+    >>> from sympy import owens_t, diff, sqrt, symbols
+    >>> h, a = symbols('h a', real=True)
+    >>> owens_t(0, a)
+    atan(a)/(2*pi)
+    >>> owens_t(h, 1)
+    1/8 - erf(sqrt(2)*h/2)**2/8
+    >>> diff(owens_t(h, a), h)
+    -sqrt(2)*exp(-h**2/2)*erf(sqrt(2)*a*h/2)/(4*sqrt(pi))
+    >>> owens_t(1, 2).evalf()
+    0.0784681869930841
+
+    References
+    ==========
+
+    .. [1] https://en.wikipedia.org/wiki/Owen%27s_T_function
+    """
+
+    nargs = 2
+
+    @classmethod
+    def eval(cls, h, a):
+        if h is S.NaN or a is S.NaN:
+            return S.NaN
+        if a.is_zero:
+            return S.Zero
+        if h.is_zero:
+            return atan(a)/(2*pi)
+        if h in (S.Infinity, S.NegativeInfinity) and a.is_extended_real:
+            return S.Zero
+        if a in (S.Infinity, S.NegativeInfinity) and h.is_extended_real:
+            from sympy.functions.elementary.complexes import Abs
+            result = erfc(Abs(h)/sqrt(2))/4
+            return result if a is S.Infinity else -result
+        if h.could_extract_minus_sign():
+            return cls(-h, a)
+        if a.could_extract_minus_sign():
+            return -cls(h, -a)
+        if a is S.One:
+            return (1 - erf(h/sqrt(2))**2)/8
+
+    def fdiff(self, argindex=1):
+        h, a = self.args
+        if argindex == 1:
+            return -exp(-h**2/2)*erf(a*h/sqrt(2))/(2*sqrt(2*pi))
+        if argindex == 2:
+            return exp(-h**2*(1 + a**2)/2)/(2*pi*(1 + a**2))
+        raise ArgumentIndexError(self, argindex)
+
+    def _eval_is_real(self):
+        if all(arg.is_real for arg in self.args):
+            return True
+
+    def _eval_is_finite(self):
+        if all(arg.is_extended_real for arg in self.args):
+            return True
+
+    def _eval_conjugate(self):
+        h, a = self.args
+        if a.is_extended_real:
+            return self.func(h.conjugate(), a)
+
+    def _eval_rewrite_as_Integral(self, h, a, **kwargs):
+        from sympy.integrals.integrals import Integral
+        t = Dummy('t')
+        return Integral(exp(-h**2*(1 + t**2)/2)/(1 + t**2),
+                        (t, 0, a))/(2*pi)
+
+    def _eval_evalf(self, prec):
+        from sympy.core.expr import Expr
+        from sympy.external.mpmath import local_workprec
+        if not all(arg.is_number for arg in self.args):
+            return self
+        h, a = self.args
+        if a.is_real:
+            h, a = [arg._to_mpmath(prec) for arg in self.args]
+            with local_workprec(prec) as ctx:
+                # t = tan(theta) removes the denominator and keeps the
+                # integration interval bounded even for large a.
+                result = ctx.quad(lambda theta:
+                    ctx.exp(-h*h/(2*ctx.cos(theta)**2)),
+                    [0, ctx.atan(a)])/(2*ctx.pi)
+            return Expr._from_mpmath(result, prec)
+        return self.rewrite('Integral')._eval_evalf(prec)
+
