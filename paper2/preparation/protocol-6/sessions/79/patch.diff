+class IntegrationSolver:
+    """Drive integration rules with state local to one search.
+
+    Rules yield :class:`IntegralInfo` to request a subintegral. The solver
+    sends the resulting Rule back to the suspended rule. Ordinary rules
+    returning Rule or None are supported as well.
+
+    ``max_depth=1`` allows the root rules to run but leaves all requested
+    subintegrals unevaluated. By default depth is unlimited and all useful
+    alternatives are retained. With ``branch=False``, search stops at the
+    first complete alternative.
+    """
+
+    def __init__(self, *, max_depth=None, branch=True, **options):
+        if max_depth is not None and (not isinstance(max_depth, int) or max_depth < 0):
+            raise ValueError('max_depth must be a nonnegative integer or None')
+        self.max_depth = max_depth
+        self.branch = branch
+        self.options = options
+        self._integral_cache = set()
+        self._parts_u_cache = defaultdict(int)
+        self._depth = 0
+
+    def _run(self, result):
+        if not isinstance(result, GeneratorType):
+            return result
+        answer = None
+        try:
+            while True:
+                try:
+                    request = result.send(answer)
+                except StopIteration as exc:
+                    return exc.value
+                if isinstance(request, IntegralInfo):
+                    answer = self.solve(request)
+                elif isinstance(request, PartsUCheck):
+                    answer = self._parts_u_cache[request.u] <= 2
+                    if answer:
+                        self._parts_u_cache[request.u] += 1
+                elif isinstance(request, BranchQuery):
+                    answer = self.branch
+                else:
+                    raise TypeError('Unknown integration request: %r' % (request,))
+        finally:
+            result.close()
+
+    def solve(self, integrand, symbol=None):
+        """Return integration steps for an expression or an IntegralInfo."""
+        if isinstance(integrand, IntegralInfo):
+            integrand, symbol = integrand
+        cachekey = integrand.xreplace({symbol: _cache_dummy})
+        if (cachekey in self._integral_cache or
+                (self.max_depth is not None and self._depth >= self.max_depth)):
+            return DontKnowRule(integrand, symbol)
+        self._integral_cache.add(cachekey)
+        self._depth += 1
+        try:
+            return self._run(_integral_steps(integrand, symbol))
+        finally:
+            self._depth -= 1
+            self._integral_cache.remove(cachekey)
+            if self._depth == 0:
+                self._parts_u_cache.clear()
+
