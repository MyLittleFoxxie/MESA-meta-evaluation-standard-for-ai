+def array_simplify(expr):
+    r"""Collect tensor-product terms by linearity in one slot at a time.
+
+    Unlike canonicalization, this also factors sums of tensor products. Only
+    terms agreeing in every slot except one are grouped. Slots are considered
+    from left to right, repeating until no further terms can be collected.
+    The result can depend on this order when several factorizations exist.
+
+    Examples
+    ========
+
+    >>> from sympy import MatrixSymbol
+    >>> from sympy.tensor.array.expressions import (
+    ...     ArrayAdd, ArrayTensorProduct, array_simplify)
+    >>> A = MatrixSymbol('A', 3, 4)
+    >>> B = MatrixSymbol('B', 4, 5)
+    >>> C = MatrixSymbol('C', 4, 5)
+    >>> array_simplify(ArrayAdd(ArrayTensorProduct(A, B),
+    ...                         ArrayTensorProduct(A, C)))
