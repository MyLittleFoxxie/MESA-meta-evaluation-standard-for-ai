+        changed = False
+        for slot in range(max_slots):
+            groups = defaultdict(list)
+            for i, (coefficient, factors) in products.items():
+                if slot >= len(factors):
+                    continue
+                key = (factors[:slot], factors[slot + 1:], get_shape(factors[slot]))
