+def _split_array_coefficient(expr, extract_matrix_coeff=True):
+    """Return a commutative scalar and the ordered tensor-product factors."""
+    scalars = []
+    factors = []
+
+    def visit(arg):
+        arg = _array_mul_to_tensor_product(arg)
+        if isinstance(arg, ArrayTensorProduct):
+            for factor in arg.args:
+                visit(factor)
+        elif extract_matrix_coeff and isinstance(arg, MatMul):
+            coefficient, matrix = arg.as_coeff_mmul()
