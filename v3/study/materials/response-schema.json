{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark",
    "judgments",
    "limits"
  ],
  "properties": {
    "benchmark": {
      "type": "string"
    },
    "limits": {
      "type": "string"
    },
    "judgments": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "rating",
          "reason",
          "evidence",
          "missing",
          "checks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "A1",
              "A2",
              "A3",
              "A4",
              "A5",
              "B1",
              "B2",
              "B3",
              "B4",
              "B5"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "rated",
              "insufficient_evidence",
              "not_applicable"
            ]
          },
          "rating": {
            "type": [
              "integer",
              "null"
            ],
            "enum": [
              0,
              5,
              10,
              15,
              null
            ]
          },
          "reason": {
            "type": "string"
          },
          "missing": {
            "type": "string"
          },
          "checks": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "locator",
                "quote"
              ],
              "properties": {
                "source": {
                  "type": "string"
                },
                "locator": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
